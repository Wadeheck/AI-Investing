[Unit]
# The engine. Restart=always is the whole point: the 11.9h silent outage
# happened because boot_start.sh only ran @reboot, so a process that died
# without a reboot stayed dead until a human noticed.
# Mode is NOT encoded here on purpose. This description used to read "(paper)"
# while LIVE_TRADING=true — a static label duplicating .env drifts, and drifted.
# The banner in engine.log and data/heartbeat.json are the source of truth.
Description=AI-Investing engine
# There is deliberately no `After=network-online.target`. This is a *user* unit,
# and the user manager has no such target — `systemctl --user show
# network-online.target` reports LoadState=not-found, so the line was a silent
# no-op that read like a guarantee. The engine failed its first Longbridge call
# on every boot because of it. Network readiness is now handled in-process, with
# a bounded retry (ai_investing/net.py) that also covers blips mid-session.
# Do not re-add the ordering: it will not work and will hide the real fix.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/eugene/Projects/AI-Investing/engine
# Heal before trading: refresh whatever went stale while we were down and
# journal the gap, so the learning spine refuses to learn from trades that
# span it. Absolute path - the working directory is engine/, not the root.
ExecStartPre=/home/eugene/Projects/AI-Investing/.venv/bin/python /home/eugene/Projects/AI-Investing/scripts/startup_heal.py --defer-refresh
ExecStart=/home/eugene/Projects/AI-Investing/.venv/bin/python -m ai_investing.main
# Belt-and-braces: the heal now hands off its slow work and returns in under a
# second, but a start must never again be killed for being slow.
TimeoutStartSec=120
Restart=always
RestartSec=20
# never give up: a crash loop that stops retrying is a silent outage again
StartLimitBurst=0
StandardOutput=append:/home/eugene/Projects/AI-Investing/data/engine.log
StandardError=inherit
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
