[Unit]
Description=AI-Investing daily market-numbers refresh

[Service]
Type=oneshot
WorkingDirectory=/home/eugene/Projects/AI-Investing
ExecStartPre=/home/eugene/Projects/AI-Investing/scripts/wait_online.sh
ExecStart=/home/eugene/Projects/AI-Investing/.venv/bin/python scripts/refresh_market_data.py
StandardOutput=append:/home/eugene/Projects/AI-Investing/data/market_refresh_cron.log
StandardError=append:/home/eugene/Projects/AI-Investing/data/market_refresh_cron.log
