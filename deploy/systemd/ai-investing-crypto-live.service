[Unit]
Description=AI-Investing hourly crypto-signal refresh

[Service]
Type=oneshot
WorkingDirectory=/home/eugene/Projects/AI-Investing
ExecStartPre=/home/eugene/Projects/AI-Investing/scripts/wait_online.sh
ExecStart=/home/eugene/Projects/AI-Investing/.venv/bin/python scripts/refresh_crypto_live.py
StandardOutput=append:/home/eugene/Projects/AI-Investing/data/crypto_refresh_cron.log
StandardError=append:/home/eugene/Projects/AI-Investing/data/crypto_refresh_cron.log
