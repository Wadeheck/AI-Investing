# ============================================================================
#  AI-Investing — configuration
#  Copy to `.env` and fill in. Everything has a safe default; the engine runs
#  in PAPER mode with SYNTHETIC data and NO keys out of the box.
# ============================================================================

# --- Safety -----------------------------------------------------------------
# LIVE_TRADING=false keeps everything simulated. Only set true when you have
# funded a broker below and have watched paper trading behave for weeks.
LIVE_TRADING=false
STARTING_CASH=100000          # paper account size (in BASE_CURRENCY)
BASE_CURRENCY=USD

# --- What to trade ----------------------------------------------------------
# Multi-market via Longbridge: mix US, HK, China A, and SG symbols freely.
# yfinance-style suffixes for data (0700.HK, 600519.SS, 300750.SZ, D05.SI);
# Longbridge live symbols (700.HK, D05.SG) are bridged automatically.
# e.g. STOCK_WATCHLIST=AAPL,NVDA,MSFT,0700.HK,9988.HK,1211.HK,600519.SS,D05.SI,ES3.SI,GLD,XLP
STOCK_WATCHLIST=AAPL,NVDA,TSLA,MSFT,AMZN
CRYPTO_WATCHLIST=BTC/USD,ETH/USD,SOL/USD
POLL_SECONDS=300              # how often the autonomous loop re-evaluates

# --- Market data provider ---------------------------------------------------
# synthetic | stooq | yfinance | ccxt
#   synthetic = offline pseudo-data (default, zero setup)
#   stooq     = free real stock data over HTTP, no key (pip: none)
#   yfinance  = free real stock data (pip install yfinance)
#   ccxt      = real crypto data from the exchange below (pip install ccxt)
DATA_PROVIDER=synthetic
CRYPTO_EXCHANGE=coinbase       # coinbase | gemini | binance | kraken (via ccxt)
DATA_TIMEFRAME=1d             # 1d | 1h | 15m | 5m ... (intraday needs yfinance/ccxt; tighten POLL_SECONDS too)

# --- Brokers (execution) ----------------------------------------------------
# paper | longbridge | moomoo
STOCK_BROKER=paper

# Longbridge / LongPort OpenAPI  (https://open.longbridge.com/)
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=

# moomoo OpenAPI — requires the OpenD gateway running locally
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRADE_PASSWORD=
MOOMOO_TRD_ENV=SIMULATE          # SIMULATE (paper) until validated; REAL for live

# Crypto exchange API keys (used when LIVE_TRADING=true; via ccxt)
CRYPTO_API_KEY_NAME=My Trading Bot
CRYPTO_API_KEY=account-IHDc6MzSxZsbnfKhL9sF
CRYPTO_API_SECRET=3zUh8KWrZK5yPL9MdKPQ5dcT1Pap
CRYPTO_API_PASSWORD=           # some exchanges (e.g. coinbase) need a passphrase
CRYPTO_SANDBOX=false          # true -> use the exchange testnet/sandbox (validate here first)

# --- News + sentiment + global briefing (LLM) -------------------------------
# Used for news sentiment, pump/hype detection, and your global briefing.
# Provider priority: ANTHROPIC_API_KEY (if set) > BYTEPLUS_API_KEY (if set) >
# DEEPSEEK_API_KEY (if set) > none. BytePlus uses its FAST model for the
# frequent per-cycle sentiment scoring and its SMART model for the global
# briefing. All are called directly over the stdlib (no SDK needed).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

BYTEPLUS_API_KEY=
BYTEPLUS_LLM_SMART=seed-2-0-pro-260328
BYTEPLUS_LLM_FAST=seed-2-0-mini-260428

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # cheap+fast for high-volume scoring; upgrade path if set

# --- Historical news archives (free registration keys) ----------------------
# Guardian Open Platform (https://open-platform.theguardian.com/): market-grade
# historical headlines to fill/replace the wiki-thin days in the news archive.
# Free tier: 500 calls/day, 1 call/sec.
GUARDIAN_API_KEY=
# NYT Archive API (https://developer.nytimes.com/) - same purpose, when you get it.
NYT_API_KEY=

# --- Local open-source LLM (FREE, preferred) --------------------------------
# Ollama server; when up, ALL news digestion runs locally at zero cost and the
# cloud keys above become fallback only. LLM_PREFER_LOCAL=false flips priority.
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen3.6:27b     # smart tier: daily briefing / deep scans
LOCAL_LLM_MODEL_FAST=qwen3:8b   # fast tier: per-cycle news digestion (speed matters)
LLM_PREFER_LOCAL=true

# NEWS_RSS=   # leave unset to use the full built-in global feed list (see config.py); set only to OVERRIDE it

# --- The Brain (macro & relationship intelligence — docs/BRAIN.md) ----------
BRAIN_ENABLED=true
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html (CPI, Fed funds,
# unemployment, yield curve). Optional — the brain runs without it on VIX/DXY/yields.
FRED_API_KEY=
# Events below this credibility are labeled NOISE: visible in the dashboard,
# never propagated, never traded on.
BRAIN_CREDIBILITY_THRESHOLD=0.35
BRAIN_MAX_HOPS=3              # how far a shock ripples through the graph
BRAIN_DECAY=0.6               # per-hop attenuation
# Memory: articles are hash-deduped in data/brain.db — an already-seen headline
# NEVER reaches an LLM again. Feeds use conditional GET (data/feed_cache.json).
BRAIN_ADVISE_TOP_N=10         # size of the --advise trade list

# --- Telegram alerts --------------------------------------------------------
# @BotFather -> token; message your bot then read the chat id from
# https://api.telegram.org/bot<token>/getUpdates . Test: python3 -m ai_investing.main --test-alert
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ON_TRADE=true
ALERT_ON_ERROR=true
ALERT_ON_KILL=true
ALERT_MIN_NOTIONAL=0           # only alert on fills at/above this $ notional

# --- Alternative data (the manipulation/hype edge) --------------------------
# Off by default (avoids hammering free APIs each cycle). Probe: python3 -m ai_investing.main --altdata
ALTDATA_ENABLED=false
POLYGON_API_KEY=               # options flow (stocks) — polygon.io free tier
COINGECKO_API_KEY=             # optional — crypto hype works without a key (rate-limited)
REDDIT_USER_AGENT=ai-investing/0.1 (research)   # social velocity via reddit public search (no key)

# --- Risk limits (the guardrails) -------------------------------------------
RISK_MAX_POSITION_WEIGHT=0.15  # max fraction of equity in any one asset
RISK_MAX_GROSS_EXPOSURE=1.0    # max sum of |position weights|
RISK_STOP_LOSS=0.08            # per-trade stop loss (8%)
RISK_TAKE_PROFIT=0.25          # per-trade take profit (25%)
RISK_MAX_DAILY_DRAWDOWN=0.05   # daily circuit breaker: halt if -5% on the day (auto-clears)
RISK_MIN_CONFIDENCE=0.35       # ignore weak signals below this confidence
RISK_MAX_OPEN_POSITIONS=12

# --- Safety layer (bounded worst case) --------------------------------------
SAFETY_MAX_TRAILING_DD=0.15       # halt (latched) if -15% from the equity peak
SAFETY_MAX_INCEPTION_DD=0.25      # halt (latched) if -25% from your starting equity
SAFETY_MAX_TRADES_PER_DAY=50      # stop opening new positions past this many trades/day
SAFETY_MAX_NOTIONAL_PER_DAY=0     # 0 = off; set a $ cap (strongly recommended for live)
SAFETY_MAX_SLIPPAGE_BPS=50        # skip opening trades whose modeled cost exceeds this
SAFETY_MAX_PRICE_JUMP=0.5         # flag/skip a symbol that jumps >50% in one step (bad data?)
SAFETY_MAX_BAR_STALENESS_DAYS=5   # flag a symbol whose newest bar is older than this
SAFETY_HALT_ON_DATA_ANOMALY=true
SAFETY_FLATTEN_ON_EXIT=false      # flatten positions when the loop stops (live only)
SAFETY_FLATTEN_ON_STALL=false     # watchdog flattens if the heartbeat goes stale (live only)
SAFETY_HEARTBEAT_STALE_SECONDS=1800   # --watchdog considers the engine down past this

# --- Execution (price protection) -------------------------------------------
EXECUTION_ORDER_TYPE=limit        # limit (price-protected) | market
EXECUTION_LIMIT_BAND_BPS=25       # limit price sits this far from mid; wider = fills more, less protection
EXECUTION_STOP_AT_EXCHANGE=false  # after opening a long, rest a stop at the venue (ccxt; experimental, untested)

# --- Advanced risk (all optional; defaults shown, uncomment to override) ----
# RISK_ALLOW_SHORT=false             # permit short positions
# RISK_USE_VOL_TARGET=true           # size positions to a target volatility instead of flat weight
# RISK_TARGET_POSITION_VOL=0.02      # per-position annualized vol target
# RISK_USE_ATR_STOPS=true            # ATR-based stop/take instead of the flat RISK_STOP_LOSS/TAKE_PROFIT
# RISK_ATR_STOP_MULT=3.0
# RISK_ATR_TAKE_MULT=6.0
# RISK_CORR_PENALTY=0.5              # downsize correlated positions held together
# RISK_PORTFOLIO_VOL_TARGET=0.02     # whole-portfolio annualized vol target
# RISK_DD_DERISK_SCALE=2.0           # how aggressively to cut size as drawdown grows
# RISK_DD_DERISK_FLOOR=0.3           # minimum size multiplier even at max drawdown

# --- Trading cost model (all optional; defaults shown) -----------------------
# COST_ENABLED=true
# COST_COMMISSION_BPS=1.0
# COST_SPREAD_BPS=2.0
# COST_SLIPPAGE_COEF=0.1

# --- Market regime gate (all optional; defaults shown) ------------------------
# REGIME_ENABLED=true
# REGIME_HIGH_VOL=0.04               # annualized vol above this = high-vol regime
# REGIME_OOD_Z=4.0                   # z-score beyond which a bar is "out of distribution"
# REGIME_MIN_MULT=0.4                # minimum size multiplier applied in a bad regime

# --- Online learning / walk-forward (all optional; defaults shown) -----------
# LEARN_ONLINE=true
# LEARN_FORGETTING=0.999
# LEARN_PRIOR_CONFIDENCE=50.0
# LEARN_TRUST_REGION=0.01
# LEARN_MIN_SAMPLES=10
# LEARN_SAVE_EVERY=5
# LEARN_HORIZON=5
# LEARN_REG=0.01
# LEARN_WF_WINDOWS=3
# LEARN_WF_SEARCH=16
# LEARN_LAMBDA_TURNOVER=0.05
# LEARN_LAMBDA_REG=0.10
# LEARN_EMBARGO=5
# LEARN_MIN_DSR=0.60

# --- Path overrides (all optional; default to data/*.{db,json} at repo root) -
# DB_PATH=
# STATE_PATH=
# PARAMS_PATH=
# BREAKER_PATH=
# HEARTBEAT_PATH=
# USER_VIEWS_PATH=

# --- Dashboard-only overrides (all optional) ----------------------------------
# DATA_DIR=            # dir the dashboard reads state/journal from (default: ../data relative to dashboard/)
# VIEWS_PATH=          # path to views.json the dashboard reads/writes (default: ../data/views.json)

# --- Dashboard access (HTTP Basic Auth) ---------------------------------------
# Unset (default) = no auth, fine for localhost-only use. Set BOTH before
# running this anywhere reachable off localhost (systemd/Docker deployment).
DASHBOARD_USER=
DASHBOARD_PASSWORD=
